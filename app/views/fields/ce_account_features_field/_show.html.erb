<div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
  <% field.feature_rows.each do |feature_name, feature_label, enabled| %>
    <div class="flex items-center justify-between rounded-md border border-slate-200 px-4 py-3">
      <span class="pr-4 text-sm text-slate-700"><%= feature_label %></span>
      <span class="<%= enabled ? 'bg-green-500 text-white' : 'bg-slate-100 text-slate-700' %> rounded-full px-2 py-1 text-xs font-medium">
        <%= enabled ? 'Enabled' : 'Disabled' %>
      </span>
    </div>
  <% end %>
</div>
